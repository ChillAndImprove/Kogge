#
# Weekly retention of the audit log. Enable with `systemctl enable --now kogge-audit-retention.timer`.
[Unit]
Description=Weekly Kogge audit log retention

[Timer]
OnCalendar=Sun *-*-* 03:30:00
RandomizedDelaySec=30min
Persistent=true

[Install]
WantedBy=timers.target
