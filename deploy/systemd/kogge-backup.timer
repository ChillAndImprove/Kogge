#
# Daily backup of Kogge at 02:30. Enable with `systemctl enable --now kogge-backup.timer`.
[Unit]
Description=Daily Kogge backup

[Timer]
OnCalendar=*-*-* 02:30:00
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
