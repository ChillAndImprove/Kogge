{
  "realm": "kogge",
  "displayName": "Kogge",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "ssoSessionIdleTimeout": 7200,
  "ssoSessionMaxLifespan": 43200,
  "accessTokenLifespan": 300,
  "internationalizationEnabled": true,
  "supportedLocales": ["de", "en"],
  "defaultLocale": "de",
  "passwordPolicy": "length(12) and notUsername",
  "groups": [],
  "users": [
    {
      "username": "service-account-kogge-sync",
      "enabled": true,
      "serviceAccountClientId": "kogge-sync",
      "clientRoles": { "realm-management": ["view-users", "query-users", "query-groups"] }
    }
  ],
  "clients": [
    {
      "clientId": "kogge-web",
      "name": "Kogge",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KOGGE_OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["${KOGGE_PUBLIC_URL}/auth/oidc/callback"],
      "webOrigins": ["${KOGGE_PUBLIC_URL}"],
      "frontchannelLogout": false,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${KOGGE_PUBLIC_URL}/*",
        "backchannel.logout.url": "${KOGGE_INTERNAL_URL}/auth/oidc/backchannel-logout",
        "backchannel.logout.session.required": "true"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "kogge-sync",
      "name": "Kogge directory sync",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KOGGE_SYNC_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ]
}
