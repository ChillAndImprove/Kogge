# Copy to .env and adjust.
KOGGE_PUBLIC_URL=https://kogge.example.com
KOGGE_SSO_URL=https://sso.example.com
KOGGE_SSO_NAME=Company account
# Published ports (host address:port). Kogge and Keycloak speak plain HTTP: they are published on this host only,
# for a TLS reverse proxy in front of them (deploy/proxy/). Only to try Kogge out without a proxy, publish HTTP on
# all addresses (KOGGE_HTTP_PUBLISH=8080, KOGGE_SSO_PUBLISH=8081) and trust no proxy (KOGGE_TRUSTED_PROXIES= below).
KOGGE_HTTP_PUBLISH=127.0.0.1:8080
KOGGE_SSH_PUBLISH=2222
KOGGE_SSO_PUBLISH=127.0.0.1:8081
# The subnet of the stack's network and its gateway; change both if the subnet collides with a network the host
# already uses.
#KOGGE_SUBNET=172.31.252.0/24
#KOGGE_GATEWAY=172.31.252.1
# Proxies whose X-Forwarded-For Kogge trusts (client addresses for the audit log and rate limits), as addresses or
# networks, separated by commas. Unset, Kogge trusts the gateway of the stack's network (KOGGE_GATEWAY): a proxy on
# the Docker host connects from there, while clients from other machines keep their own addresses. That is safe as
# long as the published HTTP port is reachable from this host only (as above): with HTTP published on other
# addresses, IPv6 clients (forwarded by Docker's userland proxy), clients of rootless Docker and other containers
# of the host arrive from the gateway too and could claim any address; then set it empty (trust no proxy) or to the
# address of a proxy on another host. KOGGE_SSO_TRUSTED_PROXIES is the same for Keycloak (it cannot be empty).
#KOGGE_TRUSTED_PROXIES=
#KOGGE_SSO_TRUSTED_PROXIES=
# Several nodes (docker compose -f compose.yaml -f compose.ha.yaml): the load balancer's address in the subnet above,
# which the nodes trust to forward clients' addresses, and the number of workers. Separate several proxies in
# KOGGE_TRUSTED_PROXIES by spaces there.
#KOGGE_LB_ADDRESS=172.31.252.10
#KOGGE_WORKERS=2
# The containers may not gain privileges (setuid programs). Docker installed as a snap cannot start such containers
# ("exec …: operation not permitted"): set false there.
#KOGGE_NO_NEW_PRIVILEGES=true
# Language of a new installation, de or en: the default of its users and the language of its default configuration
# (project roles, issue types, statuses, workflows, page templates). It applies at the very first start only;
# afterwards the language is a setting in Administration → Settings.
KOGGE_DEFAULT_LOCALE=de
# Optional: a local administrator created at the first start (password ≥ 12 characters, without the user name).
KOGGE_BOOTSTRAP_ADMIN_USERNAME=
KOGGE_BOOTSTRAP_ADMIN_PASSWORD=
# Optional: the mail relay for notifications (TLS: starttls, tls or none).
KOGGE_SMTP_HOST=
KOGGE_SMTP_PORT=587
KOGGE_SMTP_TLS=starttls
KOGGE_SMTP_USERNAME=
KOGGE_SMTP_PASSWORD=
KOGGE_SMTP_FROM=Kogge <kogge@example.com>
# Optional: forward audit events to a SIEM, e.g. syslog+tls://siem.example.com:6514 or
# https://collector.example.com/ingest with the Authorization header below: one JSON object per audit event.
# Certificates (KOGGE_AUDIT_FORWARD_CA_FILE, _CERT_FILE, _KEY_FILE) are paths inside the container: mount them in a
# compose.override.yaml.
KOGGE_AUDIT_FORWARD_URL=
KOGGE_AUDIT_FORWARD_AUTHORIZATION=
# Where `kogge admin backup -dir /backups` writes backups on the host (writable by the container's user 10001).
KOGGE_BACKUP_DIR=./backups
